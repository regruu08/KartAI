# ==============================================================================
# ReturnZero AI Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env (or repo root .env) and fill in any API keys.
# Never commit .env files with real secrets.

SERVICE_NAME=returnzero-api
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated explicit origins + regex for Vercel previews)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https://returnzero.*\.vercel\.app$

# Database Settings (relative SQLite paths resolve deterministically under backend/)
DATABASE_URL=sqlite+aiosqlite:///./returnzero.db

# Google Gemini VLM API Settings
GEMINI_MODEL_ID=gemini-3.8-flash
PRIMARY_GEMINI_API_KEY=
BACKUP_GEMINI_API_KEY=
GEMINI_TIMEOUT_S=4.0
EXTRACT_RATE_LIMIT_PER_MIN=30

# Demo / Reset Mode Settings
DEMO_MODE=true
DEMO_TOKEN=returnzero-demo-secret-2026

# Financial / Incentive Solver Settings (0.0% default per pitch deck)
UPI_GATEWAY_FEE_PCT=0.0
