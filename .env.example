# ==============================================================================
# ReturnZero AI - Environment Configuration Template
# Team BioXtreme | Code to Cart Round 2 Buildathon
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
SERVICE_NAME=returnzero-api
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated explicit origins; preview domains handled by regex)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https://returnzero.*\.vercel\.app$

# Database Settings (async SQLite default; relative paths resolve under backend/)
DATABASE_URL=sqlite+aiosqlite:///./returnzero.db

# Google Gemini VLM API Settings
# Model ID must strictly use gemini-3.8-flash per AGENTS.md §2.4
GEMINI_MODEL_ID=gemini-3.8-flash
PRIMARY_GEMINI_API_KEY=
BACKUP_GEMINI_API_KEY=
GEMINI_TIMEOUT_S=4.0
EXTRACT_RATE_LIMIT_PER_MIN=30

# Demo / Reset Mode Settings
DEMO_MODE=true
DEMO_TOKEN=returnzero-demo-secret-2026

# Financial / Incentive Solver Settings
# UPI gateway fee percentage (default 0.0% for UPI in India per deck)
UPI_GATEWAY_FEE_PCT=0.0

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js 14)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
